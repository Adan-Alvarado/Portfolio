---
import '../styles/global.css';
import '../styles/mobile.css';
import { Font } from 'astro:assets';
import Navigation from '../components/Navigation.astro';
import DesktopLanguageSwitcher from '../components/DesktopLanguageSwitcher.astro';
import type { Locale, LocalizedPortfolioContent } from '../i18n/content';

interface Props {
	locale: Locale;
	content: LocalizedPortfolioContent;
}

const { locale, content } = Astro.props;
const configuredOrigin = import.meta.env.PUBLIC_SITE_URL?.trim();
const siteOrigin = configuredOrigin ? new URL(configuredOrigin) : Astro.url.origin;
const canonicalPath = locale === 'es' ? '/' : '/en/';
const canonical = new URL(canonicalPath, siteOrigin);
const spanishUrl = new URL('/', siteOrigin);
const englishUrl = new URL('/en/', siteOrigin);
const socialImage = new URL('/og-portfolio.png', siteOrigin);
const ogLocale = locale === 'es' ? 'es_HN' : 'en_US';
const alternateLocale = locale === 'es' ? 'en_US' : 'es_HN';
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={content.meta.description} />
		<meta name="theme-color" content="#121212" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={content.meta.title} />
		<meta property="og:description" content={content.meta.description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={locale === 'es' ? 'Portfolio de Fabricio Alvarado, desarrollo y diseño' : 'Fabricio Alvarado portfolio, development and design'} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={alternateLocale} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={content.meta.title} />
		<meta name="twitter:description" content={content.meta.description} />
		<meta name="twitter:image" content={socialImage} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="es" href={spanishUrl} />
		<link rel="alternate" hreflang="en" href={englishUrl} />
		<link rel="alternate" hreflang="x-default" href={spanishUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{content.meta.title}</title>
		<script is:inline>
			try {
				const hasStarted = sessionStorage.getItem('portfolio:loader-seen') === '1';
				const isLocaleTransition = sessionStorage.getItem('portfolio:locale-transition') === '1';
				if (!hasStarted || isLocaleTransition) {
					document.documentElement.classList.add('page-loader-enabled');
					sessionStorage.setItem('portfolio:loader-seen', '1');
				}
			} catch {
				// When storage is unavailable, keep the page immediately usable.
			}
		</script>
		<style is:inline>
			.page-loader { display: none; }
			html.page-loader-enabled .page-loader {
				position: fixed;
				inset: 0;
				z-index: 999;
				display: block;
				background: #070707;
				opacity: 1;
				visibility: visible;
				transition: opacity 420ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 420ms;
			}
			html.page-loader-ready .page-loader {
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
			}
			.page-loader__masthead {
				position: absolute;
				inset: 40px 40px auto;
				display: flex;
				justify-content: space-between;
				gap: 24px;
				color: rgb(242 241 239 / 72%);
				font-family: 'Cascadia Mono', 'SFMono-Regular', Consolas, monospace;
				font-size: 11px;
				font-weight: 600;
				letter-spacing: 0.28em;
				line-height: 1;
				text-transform: uppercase;
			}
			.page-loader__counter {
				position: absolute;
				top: 50%;
				right: 40px;
				color: rgb(242 241 239 / 72%);
				font-family: 'Cascadia Mono', 'SFMono-Regular', Consolas, monospace;
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.06em;
				line-height: 1;
				transform: translateY(-50%);
			}
			.page-loader__progress {
				position: absolute;
				inset: auto 40px 40px;
				height: 1px;
				background: rgb(242 241 239 / 22%);
				overflow: hidden;
			}
			.page-loader__progress::before {
				position: absolute;
				inset: 0;
				background: #f2f1ef;
				content: '';
				transform: scaleX(var(--page-loader-progress, 0));
				transform-origin: left center;
				transition: transform 70ms linear;
			}
			@media (prefers-reduced-motion: reduce) {
				html.page-loader-enabled .page-loader { transition-duration: 120ms; }
				.page-loader__progress::before { transition: none; }
			}
			@media (max-width: 640px) {
				.page-loader__masthead { inset: 24px 20px auto; font-size: 9px; letter-spacing: 0.2em; }
				.page-loader__counter { right: 20px; font-size: 11px; }
				.page-loader__progress { inset: auto 20px 24px; }
			}
		</style>
		<Font cssVariable="--font-inter" preload={[{ style: 'normal' }]} />
		<Font cssVariable="--font-inspiration" preload={[{ weight: '400', style: 'normal' }]} />
		<Font cssVariable="--font-kite-one" />
	</head>
	<body>
		<div class="page-loader" data-page-loader aria-hidden="true">
			<div class="page-loader__masthead"><span>• Fabricio Alvarado</span><span>Portfolio · 2026</span></div>
			<span class="page-loader__counter" data-page-loader-counter>000</span>
			<div class="page-loader__progress"></div>
		</div>
		<a class="skip-link" href="#inicio">{content.skipLink}</a>
		<span class="cursor-dot" data-cursor-dot aria-hidden="true" hidden></span>
		<Navigation navigation={content.navigation} />
		<main><slot /></main>
		<DesktopLanguageSwitcher locale={locale} label={content.dock.languageLabel} />

		<script>
			import { initPortfolioInteractions } from '../scripts/portfolio-interactions';

			const cleanup = initPortfolioInteractions();
			const handlePageHide = (event: PageTransitionEvent) => {
				if (event.persisted) return;
				cleanup();
				window.removeEventListener('pagehide', handlePageHide);
			};
			window.addEventListener('pagehide', handlePageHide);
		</script>
	</body>
</html>
