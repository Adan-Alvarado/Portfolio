---
import { Icon } from 'astro-iconset/components';
import { Image } from 'astro:assets';
import TechStrip from '../TechStrip.astro';
import type { Locale, LocalizedPortfolioContent } from '../../i18n/content';
import capybara from '../../assets/capybara.png';

interface Props { content: LocalizedPortfolioContent; locale: Locale }

const { content, locale } = Astro.props;
const copy = content.hero;
const cvDocument = locale === 'en' ? '/cv/fabricio-alvarado-en.pdf' : '/cv/fabricio-alvarado-es.pdf';
---

<section id="inicio" class="portfolio-screen home-screen">
	<div class="screen-inner">
		<div class="home-stage">
			<div class="capybara-wrap" data-reveal="hero-character" data-reveal-order="3">
				<div class="capybara-glow"></div>
				<span class="capybara-steam" aria-hidden="true"><i></i><i></i></span>
				<Image src={capybara} alt={copy.characterAlt} width={446} height={470} format="webp" quality={95} loading="eager" />
			</div>

			<div class="hero-copy">
				<p class="section-kicker hero-kicker">{copy.kicker}</p>
				<h1 class="hero-title" aria-label={copy.titleAria} data-reveal="hero-title" data-reveal-order="0">
					<span class="hero-scan-line" aria-hidden="true"></span>
					<span class="developer-word" aria-hidden="true">
						<span class="script-letter script-d">D</span>
						<span class="developer-eve">eve</span>
						<span class="script-letter script-l">l</span>
						<span class="developer-oper">oper</span>
					</span>
					<span class="designer-word"><span class="plus">+</span> designer</span>
				</h1>

				<div class="hero-profile-reveal" data-reveal="hero-profile" data-reveal-order="1">
					<div class="profile-ticket">
						<div class="profile-dark">
							<a class="github-mark" href="https://github.com/Adan-Alvarado" target="_blank" rel="noreferrer" aria-label="Perfil de GitHub de Fabricio Alvarado"><Icon name="lucide:github" width="52" height="52" aria-hidden="true" /></a>
							<div>
								<strong>Fabricio Alvarado</strong>
								<a class="cv-download" href={cvDocument} download hreflang={locale} lang={locale} title={copy.cvLanguage}>{copy.downloadCv} <span><Icon name="lucide:download" width="22" height="22" aria-hidden="true" /></span></a>
							</div>
						</div>
						<p>{copy.availability[0]}<br />{copy.availability[1]}</p>
					</div>
				</div>
			</div>

			<div class="hero-metrics-row">
				<aside class="hero-stats" aria-label={copy.statsLabel} data-reveal="hero-stats" data-reveal-order="2">
					{copy.stats.map((stat) => (
						<div><strong>{stat.value}</strong><p>{stat.emphasis === 0 ? <b>{stat.lines[0]}</b> : stat.lines[0]}<br />{stat.emphasis === 1 ? <b>{stat.lines[1]}</b> : stat.lines[1]}</p></div>
					))}
				</aside>
			</div>
		</div>

		<TechStrip revealOrder={4} label={copy.technologiesLabel} />
	</div>
</section>

<style>
	.home-screen .profile-dark .cv-download {
		outline-offset: 4px;
	}

	.home-screen .profile-dark .github-mark {
		text-decoration: none;
	}

	.home-screen .profile-dark .github-mark:focus-visible {
		outline: 2px solid #f2f1ef;
		outline-offset: 3px;
	}

	.home-screen .profile-dark .cv-download:focus-visible {
		outline: 2px solid #f2f1ef;
	}

	.home-screen .profile-dark .cv-download span {
		border-radius: 0;
		background: transparent;
		color: #171717;
	}

	.home-screen .profile-ticket > p {
		justify-content: center;
		padding: 0 18px;
		font-family: var(--font-body);
		font-weight: 300;
		font-style: normal;
		text-align: center;
	}
</style>
