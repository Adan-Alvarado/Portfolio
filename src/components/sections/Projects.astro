---
import { Icon } from 'astro-iconset/components';
import { Image } from 'astro:assets';
import ProjectGallery from '../ProjectGallery';
import StackDrawer from '../StackDrawer';
import TechStrip from '../TechStrip.astro';
import type { Locale, LocalizedPortfolioContent } from '../../i18n/content';
import penguin from '../../assets/pinguino.png';

interface Props { content: LocalizedPortfolioContent; locale: Locale }

const { content, locale } = Astro.props;
const copy = content.projects;
const stackTitleLines = locale === 'es' ? ['Stack', 'Tecnológico'] : ['Technology', 'Stack'];
---

<section id="proyectos" class="portfolio-screen projects-screen">
	<div class="screen-inner">
		<div class="projects-stage">
			<div class="projects-intro" data-reveal="projects-intro" data-reveal-order="0">
				<p class="section-kicker">{copy.kicker}</p>
				<div class="projects-title-row">
					<h2>{copy.heading[0]}<br /> {copy.heading[1]} <em>{copy.heading[2]}</em></h2>
					<div class="astronaut-slot">
						<Image src={penguin} width={162} height={135} format="webp" quality={95} loading="lazy" decoding="async" alt={copy.characterAlt} data-project-character />
					</div>
				</div>
				<span class="doodle-arrow" aria-hidden="true"><Icon name="lucide:corner-down-right" width="42" height="42" /></span>
				<div class="intro-rule"></div>

				<p class="projects-bio">{copy.bio[0]} <span>{copy.bio[1]}</span><br /> {copy.bio[2]}</p>
			</div>

			<div class="projects-gallery-reveal" data-reveal="project-cards" data-reveal-order="1"><ProjectGallery client:visible={{ rootMargin: '240px' }} locale={locale} copy={copy} /></div>
		</div>

		<div class="stack-ticket-reveal" data-reveal="stack-ticket" data-reveal-order="2">
			<div class="stack-ticket">
				<div class="github-mark" aria-hidden="true"><Icon name="lucide:github" width="44" height="44" /></div>
				<div class="stack-ticket-content">
					<strong>{stackTitleLines.map((line) => <span>{line}</span>)}</strong>
					<span class="stack-ticket-action">
						<StackDrawer client:visible={{ rootMargin: '240px' }} copy={copy.stack} />
					</span>
				</div>
			</div>
		</div>

		<TechStrip compact revealOrder={3} label={content.hero.technologiesLabel} />
	</div>
</section>
