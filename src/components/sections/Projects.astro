---
import { Icon } from 'astro-iconset/components';
import { getImage, Image } from 'astro:assets';
import ProjectGallery from '../ProjectGallery';
import StackDrawer from '../StackDrawer';
import TechStrip from '../TechStrip.astro';
import type { Locale, LocalizedPortfolioContent } from '../../i18n/content';
import type { ProjectMediaMap } from '../../types/portfolio';
import penguin from '../../assets/pinguino.png';
import postOne from '../../assets/Post-1.png';
import postTwo from '../../assets/Post-2.png';
import postThree from '../../assets/Post-3.png';
import postFour from '../../assets/Post-4.png';
import postFive from '../../assets/Post-5.png';
import postSix from '../../assets/Post-6.png';
import postSeven from '../../assets/Post-7.png';
import postEight from '../../assets/Post-8.png';
import postNine from '../../assets/Post-9.png';
import postTen from '../../assets/Post-10.png';
import postEleven from '../../assets/Post-11.png';
import autoCareOne from '../../assets/Autocare-1.png';
import autoCareTwo from '../../assets/Autocare-2.png';
import fixitApi from '../../assets/Fixit-api.png';

interface Props { content: LocalizedPortfolioContent; locale: Locale }

const { content, locale } = Astro.props;
const copy = content.projects;
const stackTitleLines = locale === 'es' ? ['Stack', 'Tecnológico'] : ['Technology', 'Stack'];
const [designOne, designTwo, designThree, designFour, designFive, designSix, designSeven, designEight, designNine, designTen, designEleven, autoOne, autoTwo, fixit] = await Promise.all([
	getImage({ src: postOne, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postTwo, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postThree, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postFour, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postFive, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postSix, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postSeven, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postEight, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postNine, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postTen, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: postEleven, width: 720, format: 'webp', quality: 80 }),
	getImage({ src: autoCareOne, width: 1100, format: 'webp', quality: 78 }),
	getImage({ src: autoCareTwo, width: 1100, format: 'webp', quality: 78 }),
	getImage({ src: fixitApi, width: 1100, format: 'webp', quality: 78 }),
]);
const projectMedia: ProjectMediaMap = {
		diseno: [
		{ src: designOne.src, alt: locale === 'es' ? 'Diseño de social media, pieza uno' : 'Social media design, piece one', width: 720, height: 900 },
		{ src: designTwo.src, alt: locale === 'es' ? 'Diseño de social media, pieza dos' : 'Social media design, piece two', width: 720, height: 900 },
		{ src: designThree.src, alt: locale === 'es' ? 'Diseño de social media, pieza tres' : 'Social media design, piece three', width: 720, height: 900 },
		{ src: designFour.src, alt: locale === 'es' ? 'Diseño de social media, pieza cuatro' : 'Social media design, piece four', width: 720, height: 900 },
		{ src: designFive.src, alt: locale === 'es' ? 'Diseño de social media, pieza cinco' : 'Social media design, piece five', width: 720, height: 900 },
		{ src: designSix.src, alt: locale === 'es' ? 'Diseño de social media, pieza seis' : 'Social media design, piece six', width: 720, height: 900 },
		{ src: designSeven.src, alt: locale === 'es' ? 'Diseño de social media, pieza siete' : 'Social media design, piece seven', width: 720, height: 900 },
		{ src: designEight.src, alt: locale === 'es' ? 'Diseño de social media, pieza ocho' : 'Social media design, piece eight', width: 720, height: 900 },
		{ src: designNine.src, alt: locale === 'es' ? 'Diseño de social media, pieza nueve' : 'Social media design, piece nine', width: 720, height: 900 },
		{ src: designTen.src, alt: locale === 'es' ? 'Diseño de social media, pieza diez' : 'Social media design, piece ten', width: 720, height: 900 },
		{ src: designEleven.src, alt: locale === 'es' ? 'Diseño de social media, pieza once' : 'Social media design, piece eleven', width: 720, height: 900 },
	],
	'auto-care': [
		{ src: autoOne.src, alt: locale === 'es' ? 'Interfaz web de Auto Care Club' : 'Auto Care Club web interface', width: 1100, height: 553 },
		{ src: autoTwo.src, alt: locale === 'es' ? 'Panel de gestión de Auto Care Club' : 'Auto Care Club management dashboard', width: 1100, height: 544 },
	],
	fixit: [{ src: fixit.src, alt: locale === 'es' ? 'Documentación de la API FixIt' : 'FixIt API documentation', width: 1100, height: 554 }],
};
---

<section id="proyectos" class="portfolio-screen projects-screen">
	<div class="screen-inner">
		<div class="projects-stage">
			<div class="projects-intro" data-reveal="projects-intro" data-reveal-order="0">
				<p class="section-kicker">{copy.kicker}</p>
				<div class="projects-title-row">
					<h2>{copy.heading[0]}<br /> {copy.heading[1]} <em>{copy.heading[2]}</em></h2>
					<div class="astronaut-slot">
						<Image src={penguin} width={162} height={135} format="webp" quality={95} loading="lazy" decoding="async" alt={copy.characterAlt} data-project-character />
					</div>
				</div>
				<span class="doodle-arrow" aria-hidden="true"><Icon name="lucide:corner-down-right" width="42" height="42" /></span>
				<div class="intro-rule"></div>

				<p class="projects-bio">{copy.bio[0]} <span>{copy.bio[1]}</span><br /> {copy.bio[2]}</p>
			</div>

			<div class="projects-gallery-reveal" data-reveal="project-cards" data-reveal-order="1"><ProjectGallery client:visible={{ rootMargin: '240px' }} locale={locale} copy={copy} media={projectMedia} /></div>
		</div>

		<div class="stack-ticket-reveal" data-reveal="stack-ticket" data-reveal-order="2">
			<div class="stack-ticket">
				<div class="github-mark" aria-hidden="true"><Icon name="lucide:github" width="44" height="44" /></div>
				<div class="stack-ticket-content">
					<strong>{stackTitleLines.map((line) => <span>{line}</span>)}</strong>
					<span class="stack-ticket-action">
						<StackDrawer client:visible={{ rootMargin: '240px' }} copy={copy.stack} />
					</span>
				</div>
			</div>
		</div>

		<TechStrip compact revealOrder={3} label={content.hero.technologiesLabel} />
	</div>
</section>
