---
import CredentialCarousel from './CredentialCarousel';
import InteractiveCredentialCarousel from './InteractiveCredentialCarousel';
import type { Credential } from '../../data/credentials';
import type { LocalizedPortfolioContent } from '../../i18n/content';

interface Props { credentials: Credential[]; copy: LocalizedPortfolioContent['experience'] }

const { credentials, copy } = Astro.props;
const hasBack = credentials.some((credential) => credential.back);
---

<div class="credential-carousel" data-reveal="experience-credentials" data-reveal-order="1">
	{hasBack
		? <InteractiveCredentialCarousel credentials={credentials} copy={copy} client:visible />
		: <CredentialCarousel credentials={credentials} copy={copy} client:visible />}
</div>
