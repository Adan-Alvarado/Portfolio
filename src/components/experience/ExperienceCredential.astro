---
import { getCredentials } from '../../data/credentials';
import CredentialCarousel from './CredentialCarousel';
import type { Locale, LocalizedPortfolioContent } from '../../i18n/content';

interface Props { locale: Locale; copy: LocalizedPortfolioContent['experience'] }

const { locale, copy } = Astro.props;
const credentials = getCredentials(locale);
---

<div class="credential-carousel" data-reveal="experience-credentials" data-reveal-order="1">
	<CredentialCarousel credentials={credentials} copy={copy} client:visible />
</div>
