---
import { Icon } from 'astro-iconset/components';
import { stripTechnologies } from '../data/technologies';

interface Props {
	compact?: boolean;
	revealOrder?: number;
}

const { compact = false, revealOrder } = Astro.props;
const copies = [0, 1];
---

<div
	class:list={['skills-strip', { 'projects-skills': compact }]}
	role="list"
	aria-label="Tecnologías utilizadas"
	data-reveal={revealOrder !== undefined ? 'technology-strip' : undefined}
	data-reveal-order={revealOrder}
>
	<div class="skills-track">
		{copies.map((copy) => (
			<div class="technology-group" aria-hidden={copy === 1 ? 'true' : undefined}>
				{stripTechnologies.map((technology) => (
					<span
						class="technology-item"
						role={copy === 0 ? 'listitem' : undefined}
						tabindex={copy === 0 ? 0 : -1}
						style={`--technology-color: ${technology.color}`}
					>
						<Icon
							name={technology.iconName}
							width={compact ? Math.round(technology.size * 0.9) : technology.size}
							height={compact ? Math.round(technology.size * 0.9) : technology.size}
							aria-hidden="true"
						/>
						{technology.label}
					</span>
				))}
			</div>
		))}
	</div>
</div>
