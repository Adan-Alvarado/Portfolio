---
import { Icon } from 'astro-iconset/components';
import { stripTechnologies } from '../data/technologies';

interface Props {
	compact?: boolean;
	revealOrder?: number;
	label?: string;
}

const { compact = false, revealOrder, label = 'Tecnologías utilizadas' } = Astro.props;
const copies = [0, 1];
---

<div
	class:list={['skills-strip', { 'projects-skills': compact }]}
	role="group"
	aria-label={label}
	data-technology-strip
	data-reveal={revealOrder !== undefined ? 'technology-strip' : undefined}
	data-reveal-order={revealOrder}
>
	<div class="skills-track">
		{copies.map((copy) => (
			<div class="technology-group" aria-hidden={copy === 1 ? 'true' : undefined}>
				{stripTechnologies.map((technology) => (
					<button
						type="button"
						class="technology-item"
						tabindex={copy === 0 ? undefined : -1}
						data-technology-item
						data-technology={technology.label}
						aria-pressed="false"
						style={`--technology-color: ${technology.color}`}
					>
						<Icon
							name={technology.iconName}
							width={technology.size}
							height={technology.size}
							aria-hidden="true"
						/>
						{technology.label}
					</button>
				))}
			</div>
		))}
	</div>
</div>
